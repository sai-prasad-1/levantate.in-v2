# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. See docs/SETUP.md.

# Public URL of the site (used in email links and metadata)
NEXT_PUBLIC_SITE_URL=https://www.levantate.in

# Neon Postgres (added automatically when you connect Neon from Vercel → Storage)
DATABASE_URL=

# Vercel Blob (added automatically when you connect Blob from Vercel → Storage)
BLOB_READ_WRITE_TOKEN=

# Auth.js: random secret for admin sessions. Generate with `npx auth secret`
AUTH_SECRET=
# Comma-separated emails allowed to sign in to /admin
ADMIN_EMAILS=

# Resend (email)
RESEND_API_KEY=
# Sending address on the domain verified in Resend
MAIL_FROM="Levantate Labs <noreply@communications.levantate.in>"
# Where new enquiries are sent, and where people's replies land (defaults to contact@levantate.in)
CONTACT_NOTIFY_EMAIL=contact@levantate.in

# Optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
